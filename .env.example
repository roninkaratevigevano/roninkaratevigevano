# Variabili da impostare su Vercel: Settings → Environment Variables (ambiente Production).
# In locale si possono copiare in .env (che non va mai caricato su GitHub).

# Indirizzo pubblico del sito (canonical, sitemap, pannello admin). Facoltativa finché si usa vercel.app.
SITE_URL=https://roninkaratevigevano.vercel.app

# Pannello /admin/: OAuth App di GitHub (Settings → Developer settings → OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Analytics 4: ID di misurazione (G-XXXXXXXXXX). Vuota = nessuna statistica e nessuna voce nel banner.
PUBLIC_GA_ID=

# Google Search Console, metodo "Tag HTML": solo il valore di content="..."
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Facoltative: il pannello usa già il repository e il ramo collegati a Vercel
# CMS_REPO=proprietario/ronin-karate-vigevano
# CMS_BRANCH=main
