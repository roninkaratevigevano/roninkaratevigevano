---
import { associazione } from "../data/sito";
interface Props { formato?: "compatto" | "schede"; etichetta?: string }
const { formato = "compatto", etichetta = "Segui Ronin Karate sui social" } = Astro.props;
const percorsi: Record<string, string> = {
  Instagram: "M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3Zm5 3a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.5-3.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z",
  Facebook: "M22 12A10 10 0 1 0 10.4 22v-7.1H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.3.2 2.3.2v2.5h-1.3c-1.3 0-1.7.8-1.7 1.6V12h2.8l-.5 2.9h-2.3V22A10 10 0 0 0 22 12Z",
  TikTok: "M16.5 2c.3 2.5 1.7 4 4.5 4.2v3.1a9 9 0 0 1-4.5-1.4v7.3a6.5 6.5 0 1 1-5.6-6.4v3.3a3.2 3.2 0 1 0 2.4 3.1V2Z",
};
---
<div class:list={["social-links", formato]} role="group" aria-label={etichetta}>
  {associazione.social.map((s) => (
    <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`Segui Ronin Karate su ${s.nome} (si apre in una nuova scheda)`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={percorsi[s.nome]} /></svg>
      <span class="social-testo"><b>{s.nome}</b>{formato === "schede" && <><span>{s.descrizione}</span><small>{s.account}</small></>}</span>
      {formato === "schede" && <span class="social-freccia" aria-hidden="true">↗</span>}
    </a>
  ))}
</div>

<style>
  .social-links{display:flex;gap:10px;flex-wrap:wrap}
  a{display:flex;align-items:center;gap:10px;min-height:46px;padding:10px 16px;border:1px solid #777;border-radius:999px;transition:background .2s,color .2s,border-color .2s}
  a:hover{background:var(--rosso-scuro);color:#fff;border-color:var(--rosso-scuro)}
  svg{width:21px;height:21px;fill:currentColor;flex:none}
  b{font-size:15px;font-weight:600}
  .schede{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  .schede a{position:relative;align-items:start;padding:28px 24px;border-radius:18px;min-width:0}
  .schede svg{width:28px;height:28px;margin-top:5px}
  .social-testo{min-width:0}
  .schede b{display:block;font-size:clamp(24px,2.5vw,34px);line-height:1.2;margin-bottom:10px}
  .schede .social-testo>span{display:block;font-size:16px}
  small{display:block;margin-top:14px;font-size:13px;overflow-wrap:anywhere}
  .social-freccia{margin-left:auto;font-size:24px;line-height:1.2}
  @media(max-width:960px){.schede{grid-template-columns:1fr}.schede a{padding:24px}.schede b{font-size:28px}}
</style>
