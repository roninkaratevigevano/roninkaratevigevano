---
// Il gestore privacy carica Google Maps soltanto con il consenso alla categoria "maps".
import { associazione } from "../data/sito";
const { palestra } = associazione;
---
<div class="mappa" data-src={palestra.embed} data-titolo={`${palestra.via}, Vigevano`}>
  <div class="consenso">
    <p>Google Maps è disattivato. Per mostrarlo puoi autorizzare i suoi cookie nelle preferenze. <a href="/cookie-policy/">Informazioni sui cookie</a>.</p>
    <button class="pill" type="button" data-attiva-mappa>Scegli e mostra la mappa</button>
    <a class="link-freccia" href={palestra.mappe} target="_blank" rel="noopener">Apri in Google Maps</a>
  </div>
</div>
