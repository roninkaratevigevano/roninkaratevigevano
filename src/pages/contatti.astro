---
import Base from "../layouts/Base.astro";
import Testata from "../components/Testata.astro";
import ModuloWhatsApp from "../components/ModuloWhatsApp.astro";
import Mappa from "../components/Mappa.astro";
import Orari from "../components/Orari.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { associazione, contatti, waLink, provaWhatsApp, telLink } from "../data/sito";
const { palestra } = associazione;
---
<Base titolo="Contatti e dove siamo" descrizione="Scrivici su WhatsApp per corsi, orari e lezione di prova. Ci trovi al centro sportivo H2 Sport, via Mondetti 15, Vigevano.">
  <Testata titolo="Contatti" kanji="連絡" intro="Il primo passo è un messaggio o una chiamata. Scrivici su WhatsApp per corsi e lezione di prova, oppure parlane direttamente con noi." />

  <section class="sezione bianca" aria-label="Scrivici">
    <div class="wrap pagina-contatti">
      <ModuloWhatsApp titolo="Componi il messaggio" />
      <div class="rubrica">
        <h2 class="vh">Contatti diretti</h2>
        {[contatti.principale, contatti.didattica].map((persona, i) => <div class="voce-rubrica" data-rivela>
          <small>{persona.ruolo}</small><h3>{persona.nome}</h3><p class="numero">{persona.telefono}</p>
          <div class="azioni-contatto"><a class="pill" href={i === 0 ? provaWhatsApp : waLink(persona.wa)} target="_blank" rel="noopener" aria-label={`Scrivi a ${persona.nome} su WhatsApp`}>WhatsApp ↗</a><a class="pill contorno-chiaro" href={telLink(persona.wa)} aria-label={`Chiama ${persona.nome}`}>Chiama</a></div>
        </div>)}
        <div class="social-contatti"><h3>Segui il Ronin</h3><SocialLinks /></div>
        <p class="email-secondaria">Per documenti o richieste via email:<br><a href={`mailto:${associazione.email}`}>{associazione.email}</a></p>
      </div>
    </div>
  </section>

  <section class="sezione" aria-labelledby="dove-titolo">
    <div class="wrap dove">
      <div>
        <div class="titolo-sez"><h2 id="dove-titolo" class="display">Dove siamo</h2></div>
        <p class="indirizzo-grande" data-rivela>{palestra.nome}<br>{palestra.via}<br>{palestra.citta}</p>
        <p data-rivela><a class="pill magnete" href={palestra.mappe} target="_blank" rel="noopener">Indicazioni stradali</a></p>
        <div class="orari-contatti"><Orari /></div>
        <dl class="dati" data-rivela>
          <div><dt>Sede legale</dt><dd>{associazione.sedeLegale}</dd></div>
          <div><dt>Partita IVA</dt><dd>{associazione.piva}</dd></div>
        </dl>
      </div>
      <Mappa />
    </div>
  </section>
</Base>

<style is:global>
  .pagina-contatti{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(30px,5vw,80px);align-items:start}
  .rubrica{display:grid;gap:12px}
  .voce-rubrica{padding:24px;border-radius:22px;background:var(--chiaro)}
  .voce-rubrica small{color:#555;font-size:14px}
  .voce-rubrica h3{margin:0 0 8px;font-size:24px;font-weight:650}
  .voce-rubrica .numero{margin:0 0 20px;font-weight:750;font-stretch:85%;font-size:clamp(28px,2.6vw,36px);line-height:1.1}
  .voce-rubrica .azioni-contatto .pill{flex:1}
  .social-contatti{margin-top:12px}
  .social-contatti h3{font-size:18px;margin:0 0 12px}
  .dove{display:grid;grid-template-columns:1fr 1.2fr;gap:clamp(30px,5vw,80px);align-items:start}
  .dove .mappa{min-height:460px}
  .indirizzo-grande{margin:0 0 26px;font-weight:700;font-size:clamp(28px,3vw,44px);line-height:1.15;letter-spacing:-.02em}
  .orari-contatti{margin-top:36px}
  .dati{margin:36px 0 0;display:grid;gap:14px;color:#ccc}
  .dati dt{font-size:14px;color:var(--grigio)}
  .dati dd{margin:0}
  @media (max-width:960px){
    .pagina-contatti,.dove{grid-template-columns:1fr}
    .dove .mappa{min-height:360px}
  }
</style>
